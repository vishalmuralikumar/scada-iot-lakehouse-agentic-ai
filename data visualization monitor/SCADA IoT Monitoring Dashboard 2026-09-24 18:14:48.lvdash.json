{
  "datasets": [
    {
      "name": "bee62991",
      "displayName": "scada_lakeflow_gold",
      "config": {
        "version": "1.1",
        "source": "SELECT * FROM workspace.gold.scada_lakeflow_gold ORDER BY reading_count DESC\n",
        "dimensions": [
          {
            "name": "id",
            "expr": "source.id"
          },
          {
            "name": "unit",
            "expr": "source.unit"
          },
          {
            "name": "reading_count",
            "expr": "source.reading_count"
          },
          {
            "name": "avg_value",
            "expr": "source.avg_value"
          },
          {
            "name": "min_value",
            "expr": "source.min_value"
          },
          {
            "name": "max_value",
            "expr": "source.max_value"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "displayName": "Overall Average Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "weighted_avg_value",
            "expr": "ROUND(SUM(`avg_value` * `reading_count`) / SUM(`reading_count`), 2)",
            "comment": "Weighted average of avg_value weighted by reading_count, rounded to 2 decimal places"
          },
          {
            "displayName": "Peak Sensor Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "peak_value",
            "expr": "ROUND(MAX(`max_value`), 2)",
            "comment": "Maximum of max_value, rounded to 2 decimal places"
          }
        ]
      }
    },
    {
      "name": "4bfc0dea",
      "displayName": "scada_lakeflow_silver",
      "config": {
        "version": "1.1",
        "source": "workspace.silver.scada_lakeflow_silver",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "scada_silver",
      "displayName": "scada_lakeflow_silver",
      "config": {
        "version": "1.1",
        "source": "workspace.silver.scada_lakeflow_silver",
        "dimensions": [
          {
            "name": "timestamp",
            "expr": "DATE_TRUNC('hour', source.timestamp)",
            "displayName": "Timestamp"
          },
          {
            "name": "id",
            "expr": "source.id",
            "displayName": "Sensor ID"
          },
          {
            "name": "unit",
            "expr": "source.unit",
            "displayName": "Unit"
          }
        ],
        "measures": [
          {
            "displayName": "Average Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_value",
            "expr": "AVG(value)",
            "comment": "Average of sensor readings per hour"
          },
          {
            "displayName": "Maximum Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "max_value",
            "expr": "MAX(value)",
            "comment": "Maximum sensor reading per hour"
          }
        ]
      }
    }
  ],
